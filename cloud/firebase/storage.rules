rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can upload and read their own assessment videos
    match /assessments/{userId}/{assessmentId}.{extension} {
      allow read, write: if request.auth != null && 
                         request.auth.uid == userId &&
                         extension in ['mp4', 'mov', 'avi'] &&
                         request.resource.size < 100 * 1024 * 1024; // 100MB limit
    }
    
    // Users can upload and read their own profile images
    match /profiles/{userId}/avatar.{extension} {
      allow read, write: if request.auth != null && 
                         request.auth.uid == userId &&
                         extension in ['jpg', 'jpeg', 'png'] &&
                         request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }
    
    // Public assets (read-only)
    match /public/{allPaths=**} {
      allow read;
    }
  }
}